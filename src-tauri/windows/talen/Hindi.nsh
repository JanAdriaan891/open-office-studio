; Open Office Studio: Tauri-installerteksten in het Hindi (machinevertaling door OpenAEC, zie docs/i18n.md).
; Tauri levert deze taal niet mee; ingesteld via bundle.windows.nsis.customLanguageFiles.
LangString addOrReinstall ${LANG_HINDI} "घटक जोड़ें/फिर से इंस्टॉल करें"
LangString alreadyInstalled ${LANG_HINDI} "पहले से इंस्टॉल है"
LangString alreadyInstalledLong ${LANG_HINDI} "${PRODUCTNAME} ${VERSION} पहले से इंस्टॉल है। वह कार्रवाई चुनें जो आप करना चाहते हैं और जारी रखने के लिए आगे पर क्लिक करें।"
LangString appRunning ${LANG_HINDI} "${PRODUCTNAME} चल रहा है! पहले इसे बंद करें, फिर दोबारा प्रयास करें।"
LangString appRunningOkKill ${LANG_HINDI} "${PRODUCTNAME} चल रहा है!$\nइसे बंद करने के लिए OK पर क्लिक करें"
LangString chooseMaintenanceOption ${LANG_HINDI} "वह रखरखाव कार्रवाई चुनें जो करनी है।"
LangString choowHowToInstall ${LANG_HINDI} "चुनें कि आप ${PRODUCTNAME} को कैसे इंस्टॉल करना चाहते हैं।"
LangString createDesktop ${LANG_HINDI} "डेस्कटॉप शॉर्टकट बनाएँ"
LangString dontUninstall ${LANG_HINDI} "अनइंस्टॉल न करें"
LangString dontUninstallDowngrade ${LANG_HINDI} "अनइंस्टॉल न करें (इस इंस्टॉलर में बिना अनइंस्टॉल किए पुराने संस्करण पर जाना अक्षम है)"
LangString failedToKillApp ${LANG_HINDI} "${PRODUCTNAME} को बंद नहीं किया जा सका। पहले इसे बंद करें, फिर दोबारा प्रयास करें"
LangString installingWebview2 ${LANG_HINDI} "WebView2 इंस्टॉल हो रहा है..."
LangString newerVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} का नया संस्करण पहले से इंस्टॉल है! पुराना संस्करण इंस्टॉल करने की सलाह नहीं दी जाती। यदि आप सचमुच यह पुराना संस्करण इंस्टॉल करना चाहते हैं, तो पहले वर्तमान संस्करण को अनइंस्टॉल करना बेहतर है। वह कार्रवाई चुनें जो आप करना चाहते हैं और जारी रखने के लिए आगे पर क्लिक करें।"
LangString older ${LANG_HINDI} "पुराना"
LangString olderOrUnknownVersionInstalled ${LANG_HINDI} "आपके सिस्टम पर ${PRODUCTNAME} का $R4 संस्करण इंस्टॉल है। इंस्टॉल करने से पहले वर्तमान संस्करण को अनइंस्टॉल करने की सलाह दी जाती है। वह कार्रवाई चुनें जो आप करना चाहते हैं और जारी रखने के लिए आगे पर क्लिक करें।"
LangString silentDowngrades ${LANG_HINDI} "इस इंस्टॉलर में पुराने संस्करण पर जाना अक्षम है, इसलिए साइलेंट इंस्टॉलेशन संभव नहीं है। ग्राफ़िकल इंस्टॉलर का उपयोग करें।$\n"
LangString unableToUninstall ${LANG_HINDI} "अनइंस्टॉल नहीं हो सका!"
LangString uninstallApp ${LANG_HINDI} "${PRODUCTNAME} अनइंस्टॉल करें"
LangString uninstallBeforeInstalling ${LANG_HINDI} "इंस्टॉल करने से पहले अनइंस्टॉल करें"
LangString unknown ${LANG_HINDI} "अज्ञात"
LangString webview2AbortError ${LANG_HINDI} "WebView2 इंस्टॉल नहीं हो सका! इसके बिना ऐप नहीं चल सकता। इंस्टॉलर फिर से चलाकर देखें।"
LangString webview2DownloadError ${LANG_HINDI} "त्रुटि: WebView2 डाउनलोड नहीं हो सका - $0"
LangString webview2DownloadSuccess ${LANG_HINDI} "WebView2 बूटस्ट्रैपर सफलतापूर्वक डाउनलोड हुआ"
LangString webview2Downloading ${LANG_HINDI} "WebView2 बूटस्ट्रैपर डाउनलोड हो रहा है..."
LangString webview2InstallError ${LANG_HINDI} "त्रुटि: WebView2 इंस्टॉलेशन निकास कोड $1 के साथ विफल रहा"
LangString webview2InstallSuccess ${LANG_HINDI} "WebView2 सफलतापूर्वक इंस्टॉल हुआ"
LangString deleteAppData ${LANG_HINDI} "ऐप डेटा हटाएँ"
